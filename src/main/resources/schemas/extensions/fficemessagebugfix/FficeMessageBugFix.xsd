	<xs:import namespace="http://www.fixm.aero/base/4.3" schemaLocation="../../core/base/Base.xsd"/>
	<xs:import namespace="http://www.fixm.aero/flight/4.3" schemaLocation="../../core/flight/Flight.xsd"/>
	<xs:import namespace="http://www.fixm.aero/app/ffice/1.1" schemaLocation="../../applications/fficemessage/fficetemplates/FficeTemplates.xsd"/>
	<xs:complexType name="FficeMessageBugFixFlightExtensionType">
		<xs:annotation>
			<xs:documentation>An extension to the Flight class.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="fb:FlightExtensionType">
				<xs:sequence>
					<xs:element name="flightRulesCategory" type="fx:FlightRulesCategoryType" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>FOR USE ONLY IN A FLIGHT DATA RESPONSE MESSAGE. The category of flight rules with which the pilot intends to comply. [ICAO Doc 4444, Appendix 2, Item 8]</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="FficeMessageBugFixRouteTrajectoryElementExtensionType">
		<xs:annotation>
			<xs:documentation>An extension to the RouteTrajectoryElement class.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="fb:RouteTrajectoryElementExtensionType">
				<xs:sequence>
					<xs:element name="modifiedRouteItemReference" type="fb:CharacterStringType" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>FOR USE ONLY IN A FILING STATUS, PLANNING STATUS OR TRIAL RESPONSE MESSAGE. A reference to an ATFM program name that modified the route.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
</xs:schema>
